# Postgres connection for the Geraldine cloud service.
DATABASE_URL=postgres://localhost:5432/geraldine_dev

# Public origin this service is reachable at. Must match the Mac app's base URL.
BETTER_AUTH_URL=http://localhost:4319

# Long random string. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Comma-separated extra origins allowed to call the auth endpoints.
TRUSTED_ORIGINS=http://localhost:4319

# Transactional email. Without a key, messages are printed to the server log.
# RESEND_API_KEY=
# EMAIL_FROM=Geraldine <no-reply@example.com>

# Cloudflare Turnstile. Both keys required to switch CAPTCHA on; with neither
# set, sign-up/sign-in/reset are unprotected and /api/v1/health reports it.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
